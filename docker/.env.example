# Docker Compose environment for Dj Mitica.
# Copy this file to docker/.env (same folder as docker-compose.yml) and edit.

# --- MySQL (used by the mysql service; reference the same values in config.json) ---
MYSQL_ROOT_PASSWORD=djmitica_root_pw
MYSQL_DATABASE=djmitica
MYSQL_USER=djmitica
MYSQL_PASSWORD=djmitica_pw

# --- Host port mappings ---
# Port exposed on the host for the web control panel
WEB_PORT=8090
# Port exposed on the host for NodeLink (audio node)
NODELINK_PORT=3000

# --- Voice commands (only used with `docker compose --profile voice up -d`) ---
# base.en = fast, small.en = more accurate but slower (CPU)
WHISPER_MODEL=base.en

# --- Timezone applied to all containers ---
TZ=UTC

# --- Optional: raw JSON config written to /app/config.json on first boot ---
# Takes precedence over docker/config_example.json when no config.json is mounted.
# CONFIG_JSON={"token":"YOUR_TOKEN","mysql":{"host":"mysql","port":3306,"user":"djmitica","password":"djmitica_pw","database":"djmitica"},"nodelink":{"host":"nodelink","port":3000,"password":"youshallnotpass"}}
